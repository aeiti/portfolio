---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { identity, md, site } from '../lib/site';

const additionalCreditsRaw: { year: number; title: string; discipline: string; venue?: string }[] = [
];

const normalize = (s: string) =>
  s.toLowerCase().replace(/^(the|a|disney's|disney|rodgers\s*&\s*hammerstein's)\s+/, '').replace(/[^a-z0-9]/g, '');

const projects = await getCollection('projects', ({ data }) => !data.draft);
const projectTitles = new Set(projects.map((p) => normalize(p.data.title)));

const additionalCredits = additionalCreditsRaw
  .filter((c) => !projectTitles.has(normalize(c.title)))
  .sort((a, b) => b.year - a.year);
---
<Base
  title="About"
  description={identity.pageDescriptions.about}
>
  <section class="container about">
    <p class="eyebrow">About</p>
    <h1>{identity.name}</h1>

    <div class="bio prose">
      {site.about.bio.map((para) => <p set:html={md(para)} />)}
    </div>

    <div class="grid">
      <section>
        <h2 class="section-title">Capabilities</h2>
        <ul class="list">
          {site.about.capabilities.map((c) => <li>{c}</li>)}
        </ul>
      </section>

      <section>
        <h2 class="section-title">Credentials</h2>
        <ul class="list">
          {site.about.credentials.map((c) => <li>{c}</li>)}
        </ul>
      </section>
    </div>

    {additionalCredits.length > 0 && (
    <section class="more">
      <h2 class="section-title">Selected additional credits</h2>
      <ul class="credits-list">
        {additionalCredits.map((c) => (
          <li>
            <span class="year">{c.year}</span>
            <span class="title">{c.title}</span>
            <span class="meta">{c.discipline}{c.venue ? ` — ${c.venue}` : ''}</span>
          </li>
        ))}
      </ul>
    </section>
    )}
  </section>
</Base>

<style>
  .about { padding-block: 3rem 5rem; }
  .bio { font-size: 1.1rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-top: 3rem;
  }
  @media (max-width: 680px) {
    .grid { grid-template-columns: 1fr; }
  }

  .section-title {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.98rem;
  }

  .more { margin-top: 4rem; }
  .credits-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .credits-list li {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .credits-list .year {
    font-family: var(--font-display);
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .credits-list .title {
    font-size: 1rem;
  }
  .credits-list .meta {
    color: var(--fg-muted);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  @media (max-width: 560px) {
    .credits-list li {
      grid-template-columns: 3rem 1fr;
    }
    .credits-list .meta { grid-column: 2; }
  }
</style>
