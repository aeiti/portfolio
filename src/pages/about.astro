---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const additionalCreditsRaw: { year: number; title: string; discipline: string; venue?: string }[] = [
];

const normalize = (s: string) =>
  s.toLowerCase().replace(/^(the|a|disney's|disney|rodgers\s*&\s*hammerstein's)\s+/, '').replace(/[^a-z0-9]/g, '');

const projects = await getCollection('projects', ({ data }) => !data.draft);
const projectTitles = new Set(projects.map((p) => normalize(p.data.title)));

const additionalCredits = additionalCreditsRaw
  .filter((c) => !projectTitles.has(normalize(c.title)))
  .sort((a, b) => b.year - a.year);
---
<Base
  title="About"
  description="Adam Manning is a lighting programmer, board operator, and electrician working across theatre, concerts, and corporate events in Southern California."
>
  <section class="container about">
    <p class="eyebrow">About</p>
    <h1>Adam Manning</h1>

    <div class="bio prose">
      <p>
        Adam Manning is a lighting programmer, board operator, and
        electrician based in Southern California, working across regional
        theatre, live music, and corporate events. Recent credits include
        programming and running the board at Pasadena Playhouse
        (<em>Amadeus</em>, <em>MEXODUS</em>,
        <em>The Visit</em>), South Coast Repertory, and Latino
        Theater Company at the Los Angeles Theatre Center.
      </p>
      <p>
        Adam started in 2017 on the followspot and electrics crews at
        Tuacahn's outdoor amphitheatre in Southern Utah, moving to the
        board and programming seat over the following seasons. From 2021 to
        2024 Adam was a lighting technician on Cirque du Soleil's
        <em>KÀ</em> in Las Vegas, alongside stadium and
        corporate work — from Raiders games at Allegiant Stadium to
        CrowdStrike Fal.Con Fest and the network install at the Las Vegas
        Grand Prix Plaza. Occasional lighting design for concerts and
        corporate events rounds things out.
      </p>
    </div>

    <div class="grid">
      <section>
        <h2 class="section-title">Capabilities</h2>
        <ul class="list">
          <li>Lighting programming — ETC Eos family, grandMA2/3</li>
          <li>Board operation &amp; followspot</li>
          <li>Electrics — hang, focus, maintenance, practical builds</li>
          <li>Power distribution &amp; show networking</li>
          <li>Lighting design — concerts &amp; corporate events</li>
        </ul>
      </section>

      <section>
        <h2 class="section-title">Credentials</h2>
        <ul class="list">
          <li>OSHA 10 certified (2021)</li>
          <li>IATSE Local 33</li>
        </ul>
      </section>
    </div>

    {additionalCredits.length > 0 && (
    <section class="more">
      <h2 class="section-title">Selected additional credits</h2>
      <ul class="credits-list">
        {additionalCredits.map((c) => (
          <li>
            <span class="year">{c.year}</span>
            <span class="title">{c.title}</span>
            <span class="meta">{c.discipline}{c.venue ? ` — ${c.venue}` : ''}</span>
          </li>
        ))}
      </ul>
    </section>
    )}
  </section>
</Base>

<style>
  .about { padding-block: 3rem 5rem; }
  .bio { font-size: 1.1rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-top: 3rem;
  }
  @media (max-width: 680px) {
    .grid { grid-template-columns: 1fr; }
  }

  .section-title {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.98rem;
  }

  .more { margin-top: 4rem; }
  .credits-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .credits-list li {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }
  .credits-list .year {
    font-family: var(--font-display);
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .credits-list .title {
    font-size: 1rem;
  }
  .credits-list .meta {
    color: var(--fg-muted);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  @media (max-width: 560px) {
    .credits-list li {
      grid-template-columns: 3rem 1fr;
    }
    .credits-list .meta { grid-column: 2; }
  }
</style>
