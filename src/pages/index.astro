---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { pickHero, pickShowcase } from '../lib/showcase';
import { identity, md, site } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeDisciplines = site.disciplines.filter((d) => d.showOnHome);

const all = await getCollection('projects', ({ data }) => !data.draft);
// 1 hero + a grid (ranking.homeCount in site.json)
const showcase = pickShowcase(all, site.ranking.homeCount);
const hero = pickHero(showcase);
const rest = showcase.filter((e) => e !== hero);

function slugOf(entry: (typeof all)[number]) {
  return entry.id.replace(/\/index$/, '');
}
---
<Base title={identity.name}>
  <section class="hero container">
    <p class="eyebrow">{identity.eyebrow}</p>
    <h1 set:html={md(identity.heroTitle)} />
    <p class="lede prose" set:html={md(identity.heroLede)} />
    <div class="cta-row">
      <a class="cta primary" href={`${base}/work/`}>{identity.ctaPrimary}</a>
      <a class="cta" href={`${base}/contact/`}>{identity.ctaSecondary}</a>
    </div>
  </section>

  {hero && (
    <section class="hero-image">
      <ProjectCard
        href={`${base}/work/${slugOf(hero)}/`}
        title={hero.data.title}
        discipline={hero.data.discipline}
        year={hero.data.year}
        role={hero.data.role}
        cover={hero.data.cover}
        coverKind={hero.data.coverKind}
      />
    </section>
  )}

  <section class="container featured">
    <header class="section-head">
      <h2>Selected work</h2>
      <a href={`${base}/work/`}>All projects →</a>
    </header>
    <div class="grid">
      {rest.map((entry) => (
        <ProjectCard
          href={`${base}/work/${slugOf(entry)}/`}
          title={entry.data.title}
          discipline={entry.data.discipline}
          year={entry.data.year}
          role={entry.data.role}
          cover={entry.data.cover}
          coverKind={entry.data.coverKind}
        />
      ))}
    </div>
  </section>

  <section class="container disciplines">
    <h2 class="section-title">Disciplines</h2>
    <div class="d-grid">
      {homeDisciplines.map((d, i) => (
        <a href={`${base}/work/?discipline=${d.key}`} class="d">
          <span class="d-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="d-name">{d.longLabel}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container contact-cta">
    <h2>{identity.closingCta.title}</h2>
    <p class="prose" set:html={md(identity.closingCta.text)} />
    <a class="cta primary" href={`${base}/contact/`}>{identity.closingCta.button}</a>
  </section>
</Base>

<style>
  .hero {
    padding-top: 4rem;
    padding-bottom: 3rem;
  }
  .hero h1 { margin-bottom: 1.25rem; }
  .lede {
    font-size: 1.2rem;
    color: var(--fg-muted);
    margin-bottom: 2rem;
  }
  .cta-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-image {
    max-width: var(--max-w);
    margin: 2rem auto 4rem;
    padding-inline: var(--gutter);
  }

  .featured { margin-top: 4rem; }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
    margin-bottom: 2rem;
  }
  .section-head h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: 0;
  }
  .section-head a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .section-head a:hover { color: var(--accent); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
  }

  .disciplines { margin-top: 5rem; }
  .section-title {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }
  .d-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem;
  }
  .d {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.5rem 1.25rem;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color 120ms ease, background 120ms ease;
  }
  .d:hover { border-color: var(--accent); }
  .d-num {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--accent);
  }
  .d-name {
    font-size: 1rem;
    color: var(--fg);
  }
  @media (max-width: 700px) {
    .d-grid { grid-template-columns: 1fr; }
  }

  .contact-cta {
    margin-top: 6rem;
    padding: 3rem 0;
    text-align: center;
  }
  .contact-cta h2 {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
  }
  .contact-cta .prose { margin-inline: auto; }
</style>
