---
import Base from '../layouts/Base.astro';
import ContactLink from '../components/ContactLink.astro';
import { contact } from '../lib/contact';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="Contact"
  description="Get in touch with Adam Manning for lighting programming, board operation, and electrics work."
>
  <section class="container contact">
    <p class="eyebrow">Contact</p>
    <h1>Let's talk about your show.</h1>
    <p class="lede prose">
      Available for programming, board operation, and electrics work in
      Southern California and on the road. Email is the fastest way to
      reach me — include dates, venue, and a line about the production.
    </p>

    <ContactLink kind="email" class="email" />

    <dl class="details">
      <div>
        <dt>Phone</dt>
        <dd><ContactLink kind="phone" /></dd>
      </div>
      <div>
        <dt>LinkedIn</dt>
        <dd><a href={contact.linkedin} rel="me">linkedin.com/in/adam-manning-lx</a></dd>
      </div>
      <div>
        <dt>Résumé</dt>
        <dd>
          <a href={`${base}/resume/`}>View online</a>
          <span class="sep">·</span>
          <a href={`${base}/pdfs/resume/adam-manning-resume.pdf`} download>Download PDF</a>
        </dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>{contact.location}</dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  .contact { padding-block: 4rem 5rem; }
  .lede {
    color: var(--fg-muted);
    font-size: 1.15rem;
    margin-bottom: 3rem;
  }
  .contact :global(.email) {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 0.2em;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .contact :global(.email:hover) {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .details {
    margin: 3.5rem 0 0;
    max-width: 36rem;
  }
  .details div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .details dt {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-top: 0.15rem;
  }
  .details dd { margin: 0; }
  .details a { text-decoration-color: var(--border-strong); }
  .details a:hover { color: var(--accent); }
  .sep { color: var(--fg-faint); margin-inline: 0.5rem; }
  @media (max-width: 480px) {
    .details div { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
