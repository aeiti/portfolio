---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const fullTitle = title === 'Adam Manning' ? title : `${title} — Adam Manning`;
const desc =
  description ??
  'Adam Manning — lighting programmer, board operator, and electrician for theatre, concerts, and corporate events.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = ogImage ? new URL(ogImage, Astro.site).toString() : null;
// Google Analytics only on production builds, so local dev/preview isn't counted.
const GA_ID = 'G-67DQPQMHRS';
const analytics = import.meta.env.PROD;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
    />

    {analytics && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        {/* No define:vars here: it wraps the script in a function, which would
            make gtag local and break the custom events below. */}
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag(){ dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', '${GA_ID}');
        `}></script>
      </>
    )}
  </head>
  <body>
    <header><Nav /></header>
    <main id="main"><slot /></main>
    <Footer />

    <script>
      // Custom GA events for the actions that matter. No-op when gtag isn't
      // loaded (dev builds, blockers). Contact links get their real href at
      // load, so read it at click time.
      const track = (name: string, params: Record<string, string>) =>
        (window as any).gtag?.('event', name, params);

      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest?.('a');
        if (!a) return;
        const href = a.getAttribute('href') ?? '';
        const page = location.pathname;
        if (href.startsWith('mailto:')) track('email_click', { page });
        else if (href.startsWith('tel:')) track('phone_click', { page });
        else if (href.includes('linkedin.com')) track('linkedin_click', { page });
        else if (href.endsWith('adam-manning-resume.pdf')) track('resume_download', { page });
        else if (/\/pdfs\/.+\.pdf$/.test(href)) track('document_download', { file: href.split('/').pop() ?? '', page });
      });
    </script>
  </body>
</html>
