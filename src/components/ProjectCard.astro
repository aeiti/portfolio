---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { coverKind as kindOf, disciplineGlow, disciplineLabel } from '../lib/site';

interface Props {
  href: string;
  title: string;
  discipline: string;
  year: number;
  role: string;
  cover?: ImageMetadata;
  coverKind?: string;
}

const { href, title, discipline, year, role, cover, coverKind } = Astro.props;
const kind = kindOf(coverKind);
const label = disciplineLabel(discipline);
const artStyle = `--aspect:${kind.cardAspect};--cover-fit:${kind.fit}`;
---
<a class="card" href={href}>
  {cover ? (
    <div class={`art kind-${kind.key}`} style={artStyle}>
      <Image
        src={cover}
        alt={`Cover for ${title}`}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="art kind-titlecard" style={`${artStyle};--glow:${disciplineGlow(discipline)}`} aria-hidden="true">
      <span class="tc-tag">{label} &middot; {year}</span>
      <span class="tc-title">{title}</span>
    </div>
  )}
  <div class="meta">
    <span class="tag">{label} &middot; {year}</span>
    <h3>{title}</h3>
    <p class="role">{role}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .art {
    position: relative;
    aspect-ratio: var(--aspect);
    overflow: hidden;
    background: var(--bg-elev);
    border: 1px solid var(--border);
  }
  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: var(--cover-fit);
    background: var(--bg-elev);
    transition: transform 400ms ease;
  }
  .card:hover .art :global(img) {
    transform: scale(1.02);
  }
  .art.kind-titlecard {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 1.5rem;
    background:
      radial-gradient(120% 80% at 50% 100%, var(--glow), transparent 60%),
      var(--bg-elev);
    transition: border-color 200ms ease;
  }
  .card:hover .art.kind-titlecard {
    border-color: var(--border-strong);
  }
  .tc-tag {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .tc-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.15;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  .meta {
    padding-top: 0.9rem;
  }
  .meta h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0.25rem 0 0;
  }
  .meta .role {
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    line-height: 1.3;
    color: var(--fg-muted);
  }
</style>
