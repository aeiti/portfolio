---
import ContactLink from './ContactLink.astro';
import { identity, navHref, site } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container row">
    <div>
      <p class="eyebrow">{identity.name} &middot; {identity.eyebrow}</p>
      <p class="contact">
        <ContactLink kind="email" />
      </p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {site.nav.map(({ href, label }) => <li><a href={navHref(href)}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container small">
    <span>&copy; {year} {identity.name}</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding-block: 3rem 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .contact { font-family: var(--font-display); font-size: 1.4rem; margin-top: 0.5rem; }
  .contact :global(a) { text-decoration-color: var(--border); }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: right;
  }
  nav a { color: var(--fg-muted); text-decoration: none; }
  nav a:hover { color: var(--fg); }
  .small {
    margin-top: 2rem;
    color: var(--fg-faint);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
